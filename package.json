{
  "name": "homechecker-guides-mcp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Read-only MCP server for Homechecker's professionally authored Australian homebuyer guides.",
  "license": "SEE LICENSE IN LICENSE.md",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/http.ts",
    "start": "node dist/src/http.js",
    "start:stdio": "node dist/src/stdio.js",
    "validate:snapshot": "node scripts/validate-snapshot.mjs",
    "test:core": "node scripts/test-core.mjs",
