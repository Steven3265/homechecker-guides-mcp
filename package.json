{
  "name": "homechecker-guides-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Protocol implementation of Homechecker's governed Australian residential-building guidance corpus.",
  "license": "SEE LICENSE IN LICENSE.md",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start:stdio": "node dist/src/stdio.js",
    "validate:snapshot": "node scripts/validate-snapshot.mjs",
    "test:core": "node scripts/test-core.mjs",
    "test": "npm run validate:snapshot && npm run test:core",
    "benchmark": "node scripts/run-benchmark.mjs",
    "snapshot": "node scripts/snapshot-guides.mjs",
    "check": "npm test && npm run benchmark && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
