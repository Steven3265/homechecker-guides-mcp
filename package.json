{
  "name": "homechecker-guides-mcp",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Homechecker's professionally authored Australian homebuyer guides: search, cite, build checklists.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start:stdio": "node dist/src/stdio.js",
    "validate:snapshot": "node scripts/validate-snapshot.mjs",
    "test:core": "node scripts/test-core.mjs",
    "test": "npm run validate:metadata && npm run validate:snapshot && npm run test:core",
    "benchmark": "node scripts/run-benchmark.mjs",
    "snapshot": "node scripts/snapshot-guides.mjs",
    "check": "npm test && npm run benchmark && npm run build && npm run test:http && npm run test:protocol",
    "test:protocol": "node scripts/test-protocol.mjs",
    "sync:skills": "node scripts/sync-skills.mjs",
    "validate:metadata": "node scripts/validate-release-metadata.mjs",
    "test:http": "node scripts/test-http-adapters.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.2"
  }
}
